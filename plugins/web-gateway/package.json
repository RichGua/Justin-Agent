{
  "name": "@justin/plugin-web-gateway",
  "version": "0.1.0",
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "justin": {
    "apiVersion": 1,
    "host": "./src/index.ts",
    "permissions": ["network", "ui"],
